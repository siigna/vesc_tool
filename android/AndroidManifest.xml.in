<?xml version='"1.0"'?>
<!--
    Substituted by qmake into android/AndroidManifest.xml; see vesc_tool.pro.
    The variables come from app.pri.

    Every value is wrapped in the '"..."' idiom on purpose, the XML
    declaration included. QMAKE_SUBSTITUTES strips the single quotes and
    leaves the double ones. So this file, which is not valid XML as it sits,
    substitutes into one that is. Writing the values with plain double
    quotes produces version=1.0 and name=android.permission.BLUETOOTH in the
    output, which is not XML at all.

    So do not "fix" the quoting. Check the generated
    android/AndroidManifest.xml, not this template.
-->
<manifest xmlns:android='"http://schemas.android.com/apk/res/android"'
          package='"$${VT_ANDROID_PACKAGE}"'
          android:versionName='"$$VT_VERSION"'
          android:versionCode='"$${VT_ANDROID_VERSION}"'
          android:installLocation='"auto"'>

    <!--
        targetSdkVersion is 31, not the 35 this file used to claim.

        Qt 5.15's supported Android range is API 21 to 31
        (doc.qt.io/qt-5/android.html). 31 is also what the one live,
        actively-updated Qt 5.15 application in F-Droid builds against, with
        NDK r21e and JDK 11. 35 was never validated by anything, because
        nothing ever built this manifest.

        F-Droid imposes no target floor of its own; the floor that exists is
        the OS refusing to install anything below API 23, which minSdk
        already clears.
    -->
    <uses-sdk android:minSdkVersion='"$${VT_ANDROID_MIN_SDK}"'
              android:targetSdkVersion='"$${VT_ANDROID_TARGET_SDK}"'/>

    <!--
        Declared rather than inherited. Every one of these has a call site,
        and tests/android/run.sh asserts the built APK's set matches this
        list, so a permission cannot be added without a reason or lost by
        accident.

        BLUETOOTH is capped at 30 because API 31 replaced it with the two
        permissions below it; without the cap it is requested forever on
        devices that ignore it.
    -->
    <uses-permission android:name='"android.permission.BLUETOOTH"'
                     android:maxSdkVersion='"30"'/>
    <uses-permission android:name='"android.permission.BLUETOOTH_SCAN"'/>
    <uses-permission android:name='"android.permission.BLUETOOTH_CONNECT"'/>

    <!-- Ride logging writes GNSS columns; see VescInterface::openRtLogFile.
         BACKGROUND_LOCATION and the two FOREGROUND_SERVICE permissions are
         what let that keep running with the screen off, which is the point
         of logging from a phone. -->
    <uses-permission android:name='"android.permission.ACCESS_COARSE_LOCATION"'/>
    <uses-permission android:name='"android.permission.ACCESS_FINE_LOCATION"'/>
    <uses-permission android:name='"android.permission.ACCESS_BACKGROUND_LOCATION"'/>
    <uses-permission android:name='"android.permission.FOREGROUND_SERVICE"'/>
    <uses-permission android:name='"android.permission.FOREGROUND_SERVICE_LOCATION"'/>

    <!-- The foreground service's own notification. Without this it is
         silently dropped on API 33+, and that notification is both the only
         indication logging is running and the only way to stop it. -->
    <uses-permission android:name='"android.permission.POST_NOTIFICATIONS"'/>

    <!-- VescInterface holds a PARTIAL_WAKE_LOCK while logging. -->
    <uses-permission android:name='"android.permission.WAKE_LOCK"'/>

    <!--
        Deliberately absent:

        READ_/WRITE_EXTERNAL_STORAGE, and requestLegacyExternalStorage
            Logs go to a folder the user picks once, through the storage
            access framework, which needs no permission at all. Legacy
            external storage is ignored from API 30, so the old combination
            did not work on any phone this would be installed on.
        VIBRATE
            Nothing in the tree vibrates.
        SET_ORIENTATION
            Signature-level. Never granted to an application, so requesting
            it only ever added a line to the manifest.
    -->

    <!--
        The two Qt modules' own needs, declared here rather than left to
        androiddeployqt's INSERT_PERMISSIONS placeholder (written here
        without its percent signs, because androiddeployqt replaces the token
        wherever it appears, including inside a comment about it).

        That placeholder is removed on purpose. It injected seven permissions
        derived from the linked Qt modules, and among them was
        WRITE_EXTERNAL_STORAGE: the one this fork deliberately dropped. So
        removing a permission from this file was not enough to remove it from
        the APK, and the manifest said one thing while the package did
        another. It also injected a bare BLUETOOTH with no maxSdkVersion,
        which collided with the capped one above and failed the merge, and an
        android.hardware.gamepad feature for a module that is not even built
        for Android.

        tests/android/manifest.py asserts the placeholder stays gone.
    -->
    <uses-permission android:name='"android.permission.INTERNET"'/>
    <uses-permission android:name='"android.permission.ACCESS_NETWORK_STATE"'/>

    <!-- Needed to start discovery before API 31, where BLUETOOTH_SCAN takes
         over. Capped for the same reason BLUETOOTH is. -->
    <uses-permission android:name='"android.permission.BLUETOOTH_ADMIN"'
                     android:maxSdkVersion='"30"'/>

    <!--
        No feature is required, so the app stays installable and degrades
        instead. Bluetooth LE is how it reaches a controller in practice, but
        it can also connect over TCP to a bridge, and the GNSS columns are
        simply empty without a receiver.
    -->
    <uses-feature android:name='"android.hardware.bluetooth_le"'
                  android:required='"false"'/>
    <uses-feature android:name='"android.hardware.location.gps"'
                  android:required='"false"'/>

    <!-- The INSERT_FEATURES placeholder is removed for the same reason:
         it re-declared location.gps, duplicating the one above, and added
         android.hardware.gamepad for a module Android does not build. -->

    <supports-screens android:smallScreens='"true"'
                      android:normalScreens='"true"'
                      android:largeScreens='"true"'
                      android:anyDensity='"true"'/>

    <application android:name='"org.qtproject.qt5.android.bindings.QtApplication"'
                 android:label='"$${VT_ANDROID_LABEL}"'
                 android:icon='"@drawable/icon"'
                 android:allowBackup='"true"'
                 android:extractNativeLibs='"true"'
                 android:hardwareAccelerated='"true"'>

        <activity android:name='"org.qtproject.qt5.android.bindings.QtActivity"'
                  android:label='"$${VT_ANDROID_LABEL}"'
                  android:exported='"true"'
                  android:screenOrientation='"unspecified"'
                  android:launchMode='"singleTop"'
                  android:configChanges='"orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation"'>

            <intent-filter>
                <action android:name='"android.intent.action.MAIN"'/>
                <category android:name='"android.intent.category.LAUNCHER"'/>
            </intent-filter>

            <meta-data android:name='"android.app.lib_name"'
                       android:value='"$${VT_ANDROID_LIB_NAME}"'/>
            <meta-data android:name='"android.app.qt_sources_resource_id"'
                       android:resource='"@array/qt_sources"'/>
            <meta-data android:name='"android.app.repository"'
                       android:value='"default"'/>
            <meta-data android:name='"android.app.qt_libs_resource_id"'
                       android:resource='"@array/qt_libs"'/>
            <meta-data android:name='"android.app.bundled_libs_resource_id"'
                       android:resource='"@array/bundled_libs"'/>

            <!-- Deploy Qt libs as part of the package. -->
            <meta-data android:name='"android.app.bundle_local_qt_libs"'
                       android:value='"-- %%BUNDLE_LOCAL_QT_LIBS%% --"'/>
            <meta-data android:name='"android.app.use_local_qt_libs"'
                       android:value='"-- %%USE_LOCAL_QT_LIBS%% --"'/>
            <meta-data android:name='"android.app.libs_prefix"'
                       android:value='"/data/local/tmp/qt/"'/>
            <meta-data android:name='"android.app.load_local_libs_resource_id"'
                       android:resource='"@array/load_local_libs"'/>
            <meta-data android:name='"android.app.static_init_classes"'
                       android:value='"-- %%INSERT_INIT_CLASSES%% --"'/>

            <meta-data android:name='"android.app.ministro_not_found_msg"'
                       android:value='"@string/ministro_not_found_msg"'/>
            <meta-data android:name='"android.app.ministro_needed_msg"'
                       android:value='"@string/ministro_needed_msg"'/>
            <meta-data android:name='"android.app.fatal_error_msg"'
                       android:value='"@string/fatal_error_msg"'/>

            <!--
                Kept true, and load-bearing rather than incidental: the
                foreground service logs while the application is not visible.
                Qt's template warns that an app which keeps drawing after
                ApplicationSuspended may crash; this one stops at that signal.
            -->
            <meta-data android:name='"android.app.background_running"'
                       android:value='"true"'/>

            <meta-data android:name='"android.app.auto_screen_scale_factor"'
                       android:value='"false"'/>

            <!-- full, because the widget variant is QWidget-based. minimal
                 would be faster for the Quick Controls 2 mobile variant, but
                 one template serves both.
                 -->
            <meta-data android:name='"android.app.extract_android_style"'
                       android:value='"full"'/>

            <meta-data android:name='"android.app.splash_screen_drawable"'
                       android:resource='"@drawable/splashscreen"'/>
            <meta-data android:name='"android.app.splash_screen_drawable_portrait"'
                       android:resource='"@drawable/splashscreen_port"'/>
            <meta-data android:name='"android.app.splash_screen_drawable_landscape"'
                       android:resource='"@drawable/splashscreen_land"'/>
        </activity>

        <!--
            exported="false": started only from this application's own QML,
            through Utils.startVForegroundService. Exported meant any
            application on the device could start our location service.
        -->
        <service android:name='"io.github.siigna.escargot.VForegroundService"'
                 android:enabled='"true"'
                 android:exported='"false"'
                 android:foregroundServiceType='"location"'/>

        <!-- For adding service(s) see https://wiki.qt.io/AndroidServices -->

    </application>

</manifest>
