<?xml version="1.0" encoding="utf-8"?>
<!--
    The adaptive launcher icon, used from API 26. Below that Android falls
    back to mipmap-*/icon.png.

    The foreground is a 108dp canvas whose art stays inside the central 72dp,
    because the launcher applies its own mask and may animate the layers
    independently. Both are generated by android/art/make.sh.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_background"/>
    <foreground android:drawable="@mipmap/icon_fg"/>
</adaptive-icon>
